include README.md
include LICENSE
include CHANGELOG.md
include CITATION.cff
include AUTHORS.md
include CONTRIBUTING.md
include INVENTORY.md
include requirements.txt
include VERSION

recursive-include PUBLICATION *.pdf
recursive-include PUBLICATION/figures *.png
recursive-include docs *.md
recursive-include DATA *.csv *.json

prune .venv
prune .git
prune __pycache__
prune dist
prune build

global-exclude *.pyc
global-exclude *.pyo
